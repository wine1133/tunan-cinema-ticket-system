FROM node:20-bookworm-slim AS web-builder
WORKDIR /web
COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM maven:3.9-eclipse-temurin-17 AS backend-builder
WORKDIR /build
COPY backend/pom.xml ./
RUN mvn -q -DskipTests dependency:go-offline
COPY backend/src ./src
COPY --from=web-builder /web/dist ./src/main/resources/static
RUN mvn -q -DskipTests package

FROM eclipse-temurin:17-jre-jammy
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends mariadb-server curl tzdata \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=backend-builder /build/target/tunan-cinema.jar /app/app.jar
COPY scripts/render-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh
ENV EMBEDDED_DB=1
ENV DB_URL='jdbc:mysql://127.0.0.1:3306/tunan_cinema?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false'
ENV DB_USER=tunan
ENV DB_PASSWORD=tunan_cloud_2026
ENV TZ=Asia/Shanghai
EXPOSE 8080
ENTRYPOINT ["/app/entrypoint.sh"]
